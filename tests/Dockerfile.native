ARG TAILSCALE_VERSION=v1.104.1
ARG CADDY_VERSION=2.11.4
FROM tailscale/tailscale:${TAILSCALE_VERSION} AS tailscale
FROM caddy:${CADDY_VERSION}-alpine AS caddy
FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-amd64} go test -c -o /tests/tailscale.test ./internal/tailscale \
 && CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-amd64} go test -c -o /tests/supervisor.test ./internal/supervisor
FROM alpine:3.24.2
COPY --from=build /tests /tests
COPY --from=tailscale /usr/local/bin/tailscale /testbin/tailscale
COPY --from=tailscale /usr/local/bin/tailscaled /testbin/tailscaled
COPY --from=caddy /usr/bin/caddy /testbin/caddy
RUN adduser -D -u 1000 tester
USER 1000:1000
ENV TS_FUNNEL_NATIVE_BIN=/testbin \
    TS_FUNNEL_NATIVE_CADDY=/testbin/caddy \
    TS_NO_LOGS_NO_SUPPORT=true \
    HOME=/tmp
CMD ["/bin/sh","-ec","/tests/tailscale.test -test.run TestNative -test.v && /tests/supervisor.test -test.run TestNative -test.v"]
